#include <windows.h>

1 24 "app.manifest"

1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "yt-dlp GUI"
            VALUE "FileDescription", "Portable yt-dlp front-end"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "yt-dlp-gui"
            VALUE "OriginalFilename", "yt-dlp-gui.exe"
            VALUE "ProductName", "yt-dlp GUI"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
